# MintRadar Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (used by pg Pool in db.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/mintradar

# Port the Express server listens on (default: 3002)
PORT=3002

# Node environment — set to "production" in prod to suppress debug logs
# and restrict CORS to the live origin only
NODE_ENV=production

# Comma-separated list of allowed CORS origins
# (new primary domain first, old domain kept as a fallback while both run in parallel)
# Dev default: https://mintradar.org,https://mintradar.pedani.eu,http://localhost:5173
# Prod default: https://mintradar.org,https://mintradar.pedani.eu
ALLOWED_ORIGINS=https://mintradar.org,https://mintradar.pedani.eu

# Optional. nsec of the "MintRadar Alerts" service identity used to send
# Nostr DM notifications (mint down/up transitions) to subscribers. Held in
# memory only for the process lifetime, never written to any storage. If
# unset, notification sending is disabled and the rest of the backend
# (probing, existing endpoints) is unaffected.
# NOTIFICATION_SERVICE_NSEC=nsec1...
